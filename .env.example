# Copy to .env and fill in. Never commit .env.
DAYDOR_OWNER_PASSWORD=
# At least 20 characters; not 'dev'. Set on the database login by `python -m daydor.db.bootstrap`.
DAYDOR_APP_PASSWORD=
# Signs session tokens. Required outside development; use a long random value.
DAYDOR_API_SECRET=
DAYDOR_API_CORS=https://app.example.com

# --- The model (the front door and the LLM workers). Off unless both are set; every tenant is also off until Daydor enables it. ---
# DAYDOR_MODEL_PROVIDER=claude
# ANTHROPIC_API_KEY=
# DAYDOR_MODEL_SMALL=claude-haiku-5-5
# DAYDOR_MODEL_MEDIUM=claude-sonnet-5-5
# DAYDOR_MODEL_LARGE=claude-opus-5-5
# Prices are never assumed. Without them a dollar cap cannot be enforced (a token cap always can): {"model-id": [usd_per_million_in, usd_per_million_out]}
# DAYDOR_MODEL_PRICES={}

# --- Inbound vendor webhooks: one shared signing secret per integration. No secret, no webhook. ---
# DAYDOR_WEBHOOK_SECRETS={"bank": "...", "background_check": "..."}
