 {
  "body_schema": {
   "description": "What the backend's start_hire needs today. Interview time and the offer inputs are read from\nthe workflow context by later steps (a Sprint 2 simplification), so they are collected here.\n\nThe fields below `proposed_equity` are read the same way, later still: by the employee/\nemployment_record writers (steps 10-11) and the payroll-profile writer (step 18). A real system\nwould collect these at offer acceptance, not at the start of the hire; this prototype has no\nsuch step, so -- same simplification, pushed one step further -- they ride in context from the\nstart too (see docs/integration-notes.md). They are declared optional so the 403 for a role that\ncannot open a requisition is decided before field validation, but `start` rejects a request\nmissing any of `REQUIRED_AT_START` with a 422: the interview, offer, employee and payroll-profile\nhandlers read them with bare `ctx[...]` lookups, so a missing one used to surface only later, as\na worker KeyError that retried and dead-lettered while the hire sat at that step.",
   "properties": {
    "aadhaar_last4": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "basic_da_monthly": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "channel": {
     "default": "company_site",
     "type": "string"
    },
    "comp_band_id": {
     "anyOf": [
      {
       "format": "uuid",
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "date_of_birth": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "employment_type": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "esic_ip_number": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ]
    },
    "hiring_manager_id": {
     "format": "uuid",
     "type": "string"
    },
    "interviewer_employee_id": {
     "anyOf": [
      {
       "format": "uuid",
