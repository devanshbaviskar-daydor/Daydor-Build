{
  "name": "daydor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "contract": "node scripts/gen-contract.mjs",
    "contract:sync": "node scripts/gen-contract.mjs --sync",
    "dev": "npm run contract && vite",
    "build": "npm run contract && tsc --noEmit && vite build",
    "build:preview": "npm run contract && tsc --noEmit && vite build --mode preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "test": "npm run contract && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.4"
  }
}
